---
const platform = "github";
const username = "ilgax";
---
<style>
    footer {
        margin-top: auto;
        width: 100%;
        display: flex;
        justify-content: center;
        color: black;
    }

    footer a {
        color: black;
        text-decoration: underline;
    }

    :global(.dark) footer {
        color: white;
    }

    :global(.dark) footer a {
        color: #FFFAFA;
    }
</style>
<footer>
    <p>
        <a href={`https://www.${platform}.com/${username}/${username}.github.io`}>Source</a>
    </p>
</footer>
