---
const platform = "github";
const username = "ilgax";
---
<style>
    footer {
        margin-top: auto;
        width: 100%;
        display: flex;
        justify-content: center;
        color: #FCFCFE;
    }

    footer a {
        color: #FCFCFE;
        text-decoration: underline;
    }

    :global(html:not(.dark)) footer {
        color: #1E201F;
    }

    :global(html:not(.dark)) footer a {
        color: #1E201F;
    }
</style>
<footer>
    <p>
        <a href={`https://www.${platform}.com/${username}/${username}.github.io`}>Source</a>
    </p>
</footer>
